# Ejemplo para TLS con Let's Encrypt (certbot)
# Copiar a nginx.conf y ajustar server_name y rutas de certificados

server {
    listen 443 ssl http2;
    server_name epp.example.com;

    ssl_certificate /etc/letsencrypt/live/epp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/epp.example.com/privkey.pem;

    client_max_body_size 20M;

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /storage/ {
        proxy_pass http://api:8000;
    }

    location / {
        proxy_pass http://web:80;
    }
}

server {
    listen 80;
    server_name epp.example.com;
    return 301 https://$host$request_uri;
}
